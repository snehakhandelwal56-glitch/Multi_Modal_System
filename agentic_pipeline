# -----------------------------
# 🌐 WEB AGENT (IMPROVED)
# -----------------------------
def web_search(query):
    if tavily_tool is None:
        return "Web search is unavailable because TAVILY_API_KEY is not set."

    try:
        result = tavily_tool.invoke({"query": query})
        results = result.get("results", [])

        if not results:
            return "No relevant web results found."

        # Combine results cleanly
        formatted = []
        for i, item in enumerate(results, 1):
            content = item.get("content", "")
            url = item.get("url", "")

            formatted.append(f"{i}. {content}\nSource: {url}")

        return "\n\n".join(formatted)

    except Exception as e:
        return f"Web search error: {str(e)}"


# =============================
# 💬 GENERAL CHAT AGENT
# =============================
def chat_llm(prompt):
    response = client.chat.completions.create(
        model="gpt-4o",
        messages=[{"role": "user", "content": prompt}]
    )
    return response.choices[0].message.content


# =============================
# 🧠 ROUTER AGENT
# =============================
def router(user_input=None, file_path=None):
    if file_path:
        if file_path.endswith(".pdf"):
            return "pdf"
        elif file_path.endswith((".png", ".jpg", ".jpeg")):
            return "image"
        elif file_path.endswith(".mp4"):
            return "video"
        elif file_path.endswith((".wav", ".mp3", ".m4a", ".aac", ".flac", ".ogg", ".webm")):
            return "audio"

    if user_input:
        text = user_input.lower()

        if "search" in text or "latest" in text:
            return "web"
        elif "report" in text:
            return "video"
        else:
            return "chat"

    return "chat"


# =============================
# 🚀 MAIN PIPELINE
# =============================
def handle_request(user_input=None, file_path=None):
    try:
        agent = router(user_input, file_path)
        logging.info(f"Using agent: {agent}")

        if agent == "pdf":
            return pdf_to_speech(file_path)

        elif agent == "image":
            return ask_image(file_path, user_input or "Explain this image")

        elif agent == "video":
            return video_pipeline(file_path)

        elif agent == "audio":
            return speech_to_text(file_path)

        elif agent == "web":
            return web_search(user_input)

        elif agent == "chat":
            return chat_llm(user_input)

    except Exception as e:
        logging.error(str(e))
        return f"Error: {str(e)}"


